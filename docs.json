{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TaskFlow API",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": ["index", "quickstart", "authentication", "errors"]
      },
      {
        "group": "API Reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "playground": {
    "display": "interactive",
    "examples": {
      "languages": ["curl"]
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  }
}
